# Server
PORT=3000
ALLOWED_ORIGIN=https://your-portfolio-domain.com

# SMTP (for the contact form to actually send email)
# Example values shown for Gmail — use an App Password, not your real password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com

# Where contact form submissions should be delivered
CONTACT_TO=anjana.a.vinodkumar@gmail.com
